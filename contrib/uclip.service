# Per-user systemd service for Linux.
#   mkdir -p ~/.config/systemd/user
#   cp contrib/uclip.service ~/.config/systemd/user/
#   (edit ExecStart if uclip is not in ~/.cargo/bin)
#   systemctl --user daemon-reload
#   systemctl --user enable --now uclip
# Follow the log with: journalctl --user -u uclip -f
[Unit]
Description=Universal Clipboard
After=graphical-session.target network-online.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.cargo/bin/uclip run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
